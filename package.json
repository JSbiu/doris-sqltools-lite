{
  "name": "doris-sqltools-lite",
  "displayName": "Doris SQLTools Lite",
  "description": "在 VS Code 中执行 MySQL、Apache Doris 与 Spark Thrift SQL，查看执行计划，流式导出完整 TSV，并生成可核对的 AI 反馈与字段密文。",
  "version": "0.9.8",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JSbiu/doris-sqltools-lite.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "普通查询、导出和连接管理可用；分批执行会运行工作区中的 PowerShell 参数脚本，因此需要受信任工作区。"
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "查询和结果查看可用；完整 TSV 导出、批次报告和反馈文件需要本地文件系统。"
    }
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dorisSqlLite.addConnection",
        "title": "Doris SQL Lite: 添加连接",
        "icon": "$(add)"
      },
      {
        "command": "dorisSqlLite.newQuery",
        "title": "Doris SQL Lite: 新建 SQL 查询",
        "icon": "$(new-file)"
      },
      {
        "command": "dorisSqlLite.setConnection",
        "title": "Doris SQL Lite: 为当前文件选择连接",
        "icon": "$(database)"
      },
      {
        "command": "dorisSqlLite.resetFileSessions",
        "title": "Doris SQL Lite: 重置当前文件的会话",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dorisSqlLite.editConnection",
        "title": "Doris SQL Lite: 编辑连接",
        "icon": "$(edit)"
      },
      {
        "command": "dorisSqlLite.runQuery",
        "title": "Doris SQL Lite: 执行光标处 SQL",
        "icon": "$(play)"
      },
      {
        "command": "dorisSqlLite.runQueryToTsv",
        "title": "Doris SQL Lite: 执行并导出完整 TSV",
        "icon": "$(save-as)"
      },
      {
        "command": "dorisSqlLite.runBatch",
        "title": "Doris SQL Lite: 顺序分批执行 SQL",
        "icon": "$(run-all)"
      },
      {
        "command": "dorisSqlLite.copyLastFeedback",
        "title": "Doris SQL Lite: 复制最近一次执行反馈"
      },
      {
        "command": "dorisSqlLite.saveLastFeedback",
        "title": "Doris SQL Lite: 保存最近一次执行反馈"
      },
      {
        "command": "dorisSqlLite.toggleDataMode",
        "title": "Doris SQL Lite: 切换字段密文 / 字段原文",
        "icon": "$(lock)"
      },
      {
        "command": "dorisSqlLite.exportDataKeys",
        "title": "Doris SQL Lite: 导出字段加密密钥"
      },
      {
        "command": "dorisSqlLite.importDataKeys",
        "title": "Doris SQL Lite: 导入字段加密密钥"
      },
      {
        "command": "dorisSqlLite.decryptSelectedValue",
        "title": "Doris SQL Lite: 解密选中字段值"
      },
      {
        "command": "dorisSqlLite.cancelQuery",
        "title": "Doris SQL Lite: 取消当前查询",
        "icon": "$(stop-circle)"
      },
      {
        "command": "dorisSqlLite.explainQuery",
        "title": "Doris SQL Lite: 查看光标处执行计划",
        "icon": "$(inspect)"
      },
      {
        "command": "dorisSqlLite.testConnection",
        "title": "Doris SQL Lite: 测试连接",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "dorisSqlLite.removeConnection",
        "title": "Doris SQL Lite: 删除连接",
        "icon": "$(trash)"
      },
      {
        "command": "dorisSqlLite.forgetPassword",
        "title": "Doris SQL Lite: 清除已保存密码",
        "icon": "$(key)"
      },
      {
        "command": "dorisSqlLite.setExportDirectory",
        "title": "Doris SQL Lite: 设置默认导出目录",
        "icon": "$(folder)"
      },
      {
        "command": "dorisSqlLite.clearExportDirectory",
        "title": "Doris SQL Lite: 清除默认导出目录",
        "icon": "$(close)"
      },
      {
        "command": "dorisSqlLite.forgetSqlParameters",
        "title": "Doris SQL Lite: 清除当前文件的查询参数",
        "icon": "$(close)"
      }
    ],
    "keybindings": [
      {
        "command": "dorisSqlLite.explainQuery",
        "key": "ctrl+alt+enter",
        "when": "editorTextFocus && resourceLangId == sql"
      },
      {
        "command": "dorisSqlLite.runQuery",
        "key": "ctrl+enter",
        "when": "editorTextFocus && resourceLangId == sql"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dorisSqlLite",
          "title": "Doris SQL Lite",
          "icon": "./media/icon.svg"
        }
      ]
    },
    "views": {
      "dorisSqlLite": [
        {
          "id": "dorisSqlLiteExplorer",
          "name": "连接"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "dorisSqlLite.decryptSelectedValue",
          "when": "editorHasSelection",
          "group": "navigation@4"
        },
        {
          "command": "dorisSqlLite.resetFileSessions",
          "when": "editorTextFocus && resourceLangId == sql",
          "group": "navigation@3"
        },
        {
          "command": "dorisSqlLite.explainQuery",
          "when": "editorTextFocus && resourceLangId == sql",
          "group": "navigation@1.5"
        },
        {
          "command": "dorisSqlLite.setConnection",
          "when": "editorTextFocus && resourceLangId == sql",
          "group": "navigation@0"
        },
        {
          "command": "dorisSqlLite.runQuery",
          "when": "editorTextFocus && resourceLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "dorisSqlLite.runQueryToTsv",
          "when": "editorTextFocus && resourceLangId == sql",
          "group": "navigation@1.7"
        },
        {
          "command": "dorisSqlLite.runBatch",
          "when": "editorTextFocus && resourceLangId == sql",
          "group": "navigation@1.8"
        },
        {
          "command": "dorisSqlLite.cancelQuery",
          "when": "resourceLangId == sql && dorisSqlLite.queryRunning",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "dorisSqlLite.cancelQuery",
          "when": "resourceLangId == sql && dorisSqlLite.queryRunning",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "dorisSqlLite.addConnection",
          "when": "view == dorisSqlLiteExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dorisSqlLite.newQuery",
          "when": "view == dorisSqlLiteExplorer && viewItem == dorisSqlLite.connection",
          "group": "inline"
        },
        {
          "command": "dorisSqlLite.editConnection",
          "when": "view == dorisSqlLiteExplorer && viewItem == dorisSqlLite.connection",
          "group": "database@0"
        },
        {
          "command": "dorisSqlLite.testConnection",
          "when": "view == dorisSqlLiteExplorer && viewItem == dorisSqlLite.connection",
          "group": "database"
        },
        {
          "command": "dorisSqlLite.removeConnection",
          "when": "view == dorisSqlLiteExplorer && viewItem == dorisSqlLite.connection",
          "group": "z_delete"
        },
        {
          "command": "dorisSqlLite.forgetPassword",
          "when": "view == dorisSqlLiteExplorer && viewItem == dorisSqlLite.connection",
          "group": "z_password"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dorisSqlLiteExplorer",
        "contents": "还没有数据库连接。\n[添加 MySQL / Doris / Spark Thrift 连接](command:dorisSqlLite.addConnection)"
      }
    ],
    "configuration": {
      "title": "Doris SQL Lite",
      "properties": {
        "dorisSqlLite.connections": {
          "type": "array",
          "scope": "machine",
          "description": "MySQL、Doris 与 Spark Thrift 的非敏感连接元数据。保存在用户设置中，避免主机名和账号写入项目的 .vscode/settings.json；密码保存在 VS Code SecretStorage。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "type",
              "host",
              "port",
              "username"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "MySQL",
                  "Doris",
                  "Spark"
                ]
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number",
                "default": 3306
              },
              "database": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "ssl": {
                "type": "boolean",
                "default": false,
                "description": "MySQL / Doris 连接启用 TLS。Spark Thrift 使用所选 SASL/NOSASL 传输。"
              },
              "sslVerify": {
                "type": "boolean",
                "default": true,
                "description": "校验证书链；主机为 DNS 名称时同时校验证书主机名。仅对可信的私有证书目标关闭。"
              },
              "sslCaFile": {
                "type": "string",
                "default": "",
                "description": "可选的本机 PEM CA 证书文件。留空时使用系统信任库。"
              },
              "hiveAuth": {
                "type": "string",
                "enum": [
                  "plain",
                  "nosasl"
                ],
                "description": "Spark Thrift 认证方式：plain 对应 SASL/PLAIN（也覆盖 LDAP），nosasl 对应无认证。仅用于 Spark 类型。"
              }
            }
          }
        },
        "dorisSqlLite.maxResultRows": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 100000,
          "description": "结果面板保留并用于复制 TSV 的最大行数。完整导出始终写出全部结果。"
        },
        "dorisSqlLite.exportDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "TSV 默认写入目录。留空时每次导出都由你选择位置。"
        },
        "dorisSqlLite.exportChunkRows": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 100000,
          "description": "TSV 导出时每批写入的行数。较小批次让进度更新更频繁，较大批次减少 I/O 次数。"
        },
        "dorisSqlLite.escapeSpreadsheetFormulas": {
          "type": "boolean",
          "default": true,
          "description": "对可能被 Excel、LibreOffice 或 Google Sheets 当作公式的单元格添加文本前缀。下游工具需要原值时关闭。"
        },
        "dorisSqlLite.sqlParameters": {
          "type": "boolean",
          "default": true,
          "description": "发送前替换 SQL 中的 ${name} 参数；缺少值时打开参数面板。${name=default} 提供默认值，$${name} 将占位符原样交给服务端。参数值保存在本机扩展状态中。"
        },
        "dorisSqlLite.readRowLimit": {
          "type": "number",
          "default": 0,
          "description": "读取多少行后停止。0 跟随 maxResultRows：达到显示上限后停止读取并中断语句，面板显示“已读取 N 行”。正数设置显式读取上限，-1 读取完整结果以得到精确总数。"
        },
        "dorisSqlLite.queryIdleTimeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "description": "连接无响应多久后视为中断，单位毫秒。它衡量单个状态请求或相邻数据行之间的等待，不限制 Spark 任务的总运行时长。0 关闭检查。"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check:webview": "node scripts/check-webview.js",
    "check:bundle": "node scripts/check-bundle.js",
    "preview:webviews": "node scripts/preview-webviews.js",
    "compile": "tsc -p ./",
    "lint": "eslint src",
    "test": "tsc -p ./ && node scripts/check-webview.js && node scripts/build.js && node scripts/check-bundle.js && node --test \"tests/**/*.test.js\"",
    "watch": "node scripts/build.js --watch",
    "watch:types": "tsc -p ./ -w",
    "package": "node scripts/package-runtime.js"
  },
  "dependencies": {
    "@stablelib/aes": "2.0.1",
    "@stablelib/siv": "2.0.1",
    "hive-driver": "^1.0.1",
    "mysql2": "^3.14.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0"
  }
}
